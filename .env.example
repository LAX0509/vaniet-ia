# Copia este archivo como .env. Sin ninguna clave el demo funciona en "modo demo" (respuestas guiadas).

# --- IA gratuita en cadena (una cuenta por proveedor; si uno falla o se queda sin cupo, responde el siguiente) ---
# Los niveles gratuitos pueden usar lo que se envía para mejorar sus productos: solo con datos de ejemplo.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
CEREBRAS_API_KEY=
# IA_ORDEN=gemini,groq,openrouter,mistral,cerebras
# Los modelos gratuitos cambian: ajústalos si un proveedor devuelve error 404
# GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# MISTRAL_MODEL=mistral-small-latest
# CEREBRAS_MODEL=llama-3.3-70b

# --- IA de pago (si la defines, tiene prioridad sobre la cadena gratuita) ---
ANTHROPIC_API_KEY=
# MODELO_IA=claude-opus-5-5
# MODO=demo        # fuerza el modo demo aunque haya claves

# --- WhatsApp Business (API oficial de Meta o un proveedor oficial como 360dialog) ---
# WA_PROVEEDOR=meta          # meta | 360dialog
# WA_TOKEN=
# WA_PHONE_ID=               # ID del número en Meta (no es el teléfono)
# WA_VERIFY_TOKEN=           # texto que tú inventas y pegas en la configuración del webhook
# WA_APP_SECRET=             # para validar la firma de Meta
# WA_PLANTILLA_SEGUIMIENTO=  # plantilla aprobada por Meta (ver README)
# WA_PLANTILLA_IDIOMA=es
# WA_SIMULAR=1               # prueba sin cuenta de Meta: escribe los mensajes en la consola
# SEGUIMIENTO_AUTO=1         # cron diario del Agente 3 (Ley 2300: sin domingos ni festivos)

# PORT=5000
